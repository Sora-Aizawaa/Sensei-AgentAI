# Salin menjadi .env lalu sesuaikan. JANGAN commit file .env.

# --- LLM (Ollama di laptop sendiri: gratis, tanpa token) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b        # harus sama persis dengan hasil: ollama list
LLM_JSON_MODE=1

# --- RAG ---
EMBED_MODEL=bge-m3           # ollama pull bge-m3
RAG_MODE=semantic            # lexical | semantic | hybrid
RAG_IN_CHAT=1                # 0 = jangan suntik referensi ke mode koreksi dan ngobrol
RAG_MIN_SCORE=0.5            # pilih dengan: python -m app.rag.calibrate
RAG_KEEP_RATIO=0.85

# --- Deploy ---
# Alamat frontend yang boleh memanggil API, dipisah koma
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
